{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "version",
    "default_gate",
    "rules"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "default_gate": {
      "enum": [
        "REVIEW",
        "HALT"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "priority",
          "when",
          "gate",
          "required_controls",
          "rationale"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "number"
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "connector_class": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "environment": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "data_sensitivity": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "reversibility": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "external_effect": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "boolean"
                }
              },
              "scope_authorized": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "boolean"
                }
              },
              "requester_authority": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "risk_any": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "risk_all": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "gate": {
            "enum": [
              "ALLOW",
              "REVIEW",
              "HALT"
            ]
          },
          "required_controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
