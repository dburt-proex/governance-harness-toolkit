      "additionalProperties": false,
      "properties": {
        "expectation": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exception_id",
              "uses",
              "ref",
              "owner",
              "security_rationale",
              "compensating_control",
              "review_date"
            ],
            "properties": {
              "exception_id": {
                "type": "string",
                "minLength": 1
              },
              "uses": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "security_rationale": {
                "type": "string",
                "minLength": 1
              },
              "compensating_control": {
                "type": "string",
                "minLength": 1
              },
              "review_date": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "exception_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure_behavior": {
      "type": "object",
      "required": [
        "unknown_actor_or_scope",
        "unknown_input_class",
        "missing_trusted_context",
        "missing_diffwall_evidence",
        "rejected_human_gate",
        "missing_execution_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "unknown_actor_or_scope": {
          "type": "string",
          "minLength": 1
        },
        "unknown_input_class": {
          "type": "string",
          "minLength": 1
        },
        "missing_trusted_context": {
          "type": "string",
          "minLength": 1
        },
        "missing_diffwall_evidence": {
          "type": "string",
          "minLength": 1
        },
        "rejected_human_gate": {
          "type": "string",
          "minLength": 1
        },
        "missing_execution_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_retention": {
      "type": "object",
      "required": [
        "required",
        "minimum_fields"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "minimum_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
