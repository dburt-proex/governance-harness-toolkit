{
  "type": "object",
  "required": [
    "policy_id",
    "version",
    "title",
    "default_gate",
    "input_trust_classes",
    "authorities",
    "trigger_controls",
    "protected_paths",
    "staged_writes",
    "deterministic_gate",
    "action_pinning",
    "failure_behavior",
    "evidence_retention"
  ],
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "default_gate": {
      "type": "string",
      "minLength": 1
    },
    "input_trust_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "trust",
          "may_authorize",
          "verification_required",
          "allowed_use"
        ],
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string",
            "minLength": 1
          },
          "trust": {
            "type": "string",
            "minLength": 1
          },
          "may_authorize": {
            "type": "boolean"
          },
          "verification_required": {
            "type": "boolean"
          },
          "allowed_use": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authority",
          "effect",
          "scope_required",
          "approval"
        ],
        "additionalProperties": false,
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "scope_required": {
            "type": "boolean"
          },
          "approval": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trigger_controls": {
      "type": "object",
      "required": [
        "pull_request",
        "pull_request_target",
        "workflow_dispatch"
      ],
      "additionalProperties": false,
      "properties": {
        "pull_request": {
          "type": "object",
          "required": [
            "forks",
            "external_contributors",
            "write_permissions"
