      "additionalProperties": false,
      "properties": {
        "required_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deterministic_gate": {
      "type": "object",
      "required": [
        "authority",
        "missing_evidence",
        "review_result",
        "halt_result",
        "model_override_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "missing_evidence": {
          "type": "string",
          "minLength": 1
        },
        "review_result": {
          "type": "string",
          "minLength": 1
        },
        "halt_result": {
          "type": "string",
          "minLength": 1
        },
        "model_override_allowed": {
          "type": "boolean"
        }
      }
    },
    "action_pinning": {
      "type": "object",
      "required": [
        "expectation",
        "pattern",
        "exceptions",
        "exception_requirements"
