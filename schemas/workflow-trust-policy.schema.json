          "additionalProperties": false,
          "properties": {
            "forks": {
              "type": "string",
              "minLength": 1
            },
            "external_contributors": {
              "type": "string",
              "minLength": 1
            },
            "write_permissions": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pull_request_target": {
          "type": "object",
          "required": [
            "allowed_mode",
            "untrusted_checkout",
            "untrusted_execution",
            "external_write_permissions"
          ],
          "additionalProperties": false,
          "properties": {
            "allowed_mode": {
              "type": "string",
              "minLength": 1
            },
            "untrusted_checkout": {
              "type": "string",
              "minLength": 1
            },
            "untrusted_execution": {
              "type": "string",
              "minLength": 1
            },
            "external_write_permissions": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "workflow_dispatch": {
          "type": "object",
          "required": [
            "actor_authorization_required",
            "dispatch_scope_required",
            "unauthorized_result"
          ],
          "additionalProperties": false,
          "properties": {
            "actor_authorization_required": {
              "type": "boolean"
            },
            "dispatch_scope_required": {
              "type": "boolean"
            },
            "unauthorized_result": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "staged_writes": {
      "type": "object",
      "required": [
        "required_for",
        "requirements"
