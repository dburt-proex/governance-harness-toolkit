{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-harness-toolkit.local/schemas/workflow-execution-trust.schema.json",
  "title": "Workflow Execution and Input Trust Request",
  "description": "A closed conformance record for workflow actors, events, inputs, authority, gates, writes, and retained evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "actor",
    "event",
    "inputs",
    "authority",
    "workflow",
    "targets",
    "gates",
    "evidence",
    "declared_gate"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^WXT-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "authorized", "fork"],
      "properties": {
        "class": {
          "enum": ["maintainer", "internal_contributor", "external_contributor", "automation"]
        },
        "authorized": {"type": "boolean"},
        "fork": {"type": "boolean"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dispatch_authorized"],
      "properties": {
        "name": {
          "enum": ["pull_request", "pull_request_target", "workflow_dispatch", "push", "workflow_run", "issue_comment"]
        },
        "dispatch_authorized": {"type": "boolean"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "treated_as_authoritative_instruction", "verified"],
        "properties": {
          "class": {
            "enum": [
              "pull_request_title",
              "pull_request_body",
              "comment",
              "issue",
              "commit_message",
              "repository_file",
              "configuration_file",
              "generated_artifact",
              "dependency_metadata",
              "workflow_output",
              "external_web_content"
            ]
          },
          "treated_as_authoritative_instruction": {"type": "boolean"},
          "verified": {"type": "boolean"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "search",
        "execute",
        "edit",
        "github_write",
        "network",
        "credential",
        "permission",
        "merge",
        "deploy"
      ],
      "properties": {
        "read": {"$ref": "#/$defs/authorityGrant"},
        "search": {"$ref": "#/$defs/authorityGrant"},
        "execute": {"$ref": "#/$defs/authorityGrant"},
        "edit": {"$ref": "#/$defs/authorityGrant"},
        "github_write": {"$ref": "#/$defs/authorityGrant"},
        "network": {"$ref": "#/$defs/authorityGrant"},
        "credential": {"$ref": "#/$defs/authorityGrant"},
        "permission": {"$ref": "#/$defs/authorityGrant"},
        "merge": {"$ref": "#/$defs/authorityGrant"},
        "deploy": {"$ref": "#/$defs/authorityGrant"}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_pull_request_target",
        "checks_out_untrusted_ref",
        "executes_untrusted_code",
        "write_permissions",
        "third_party_actions"
      ],
      "properties": {
        "uses_pull_request_target": {"type": "boolean"},
        "checks_out_untrusted_ref": {"type": "boolean"},
        "executes_untrusted_code": {"type": "boolean"},
        "write_permissions": {"type": "boolean"},
        "third_party_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uses", "ref"],
            "properties": {
              "uses": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_./-]+)?$"
              },
              "ref": {"type": "string", "minLength": 1, "maxLength": 128},
              "exception_id": {"type": "string", "pattern": "^PIN-EX-[A-Z0-9._-]{3,64}$"}
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trusted_context_present",
        "diffwall_evidence",
        "deterministic_approval",
        "human_approval",
        "staged_write",
        "evidence_retained",
        "model_override_requested"
      ],
      "properties": {
        "trusted_context_present": {"type": "boolean"},
        "diffwall_evidence": {"enum": ["MISSING", "ALLOW", "REVIEW", "HALT"]},
        "deterministic_approval": {"type": "boolean"},
        "human_approval": {"$ref": "#/$defs/humanApproval"},
        "staged_write": {"type": "boolean"},
        "evidence_retained": {"type": "boolean"},
        "model_override_requested": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "diffwall_run_url", "workflow_run_urls", "checks", "decision_ref"],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "diffwall_run_url": {
          "oneOf": [
            {"type": "string", "format": "uri"},
            {"type": "null"}
          ]
        },
        "workflow_run_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 500}
        },
        "decision_ref": {"type": "string", "minLength": 3, "maxLength": 500}
      }
    },
    "declared_gate": {"enum": ["ALLOW", "REVIEW", "HALT"]}
  },
  "$defs": {
    "authorityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "scope_authorized"],
      "properties": {
        "requested": {"type": "boolean"},
        "scope_authorized": {"type": "boolean"}
      }
    },
    "humanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "approver": {"type": "string", "minLength": 3, "maxLength": 200},
        "evidence_ref": {"type": "string", "format": "uri"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "approved"}},
            "required": ["status"]
          },
          "then": {
            "required": ["approver", "evidence_ref"]
          }
        }
      ]
    }
  }
}
