{
  "schema": "schemas/workflow-execution-trust.schema.json",
  "policy": "policies/workflow-execution-input-trust.json",
  "base_request": {
    "request_id": "WXT-BASE-001",
    "actor": {
      "class": "maintainer",
      "authorized": true,
      "fork": false
    },
    "event": {
      "name": "pull_request",
      "dispatch_authorized": false
