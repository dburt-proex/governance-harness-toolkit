        }
      ]
    },
    "targets": ["README.md"],
    "gates": {
      "trusted_context_present": true,
      "diffwall_evidence": "ALLOW",
      "deterministic_approval": true,
      "human_approval": {"status": "not_required"},
      "staged_write": false,
      "evidence_retained": true,
      "model_override_requested": false
