    "evidence": {
      "commit_sha": "fc1e7ca95bba3787992d381e85f71f5cbe0be771",
      "diffwall_run_url": "https://github.com/example/repository/actions/runs/1001",
      "workflow_run_urls": ["https://github.com/example/repository/actions/runs/1002"],
      "checks": ["deterministic regression suite passed"],
      "decision_ref": "WXT-BASE-001 decision"
    },
    "declared_gate": "ALLOW"
  },
